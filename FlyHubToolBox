-- Fungsi Salin Link
CopyLinkBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(DISCORD_LINK)
        local originalText = CopyLinkBtn.Text
        CopyLinkBtn.Text = "✅ Berhasil Disalin!"
        CopyLinkBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.delay(2, function()
            CopyLinkBtn.Text = originalText
            CopyLinkBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
        end)
    else
        StatusLabel.Text = "⚠️ Executor tidak support setclipboard"
    end
end)

-- Fungsi Verifikasi Key
local function CheckKey()
    local userInput = InputBox.Text
    
    if userInput == "" then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        StatusLabel.Text = "⚠️ Key tidak boleh kosong!"
        return
    end
    
    if userInput == VALID_KEY then
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        StatusLabel.Text = "✅ Key Valid! Menyimpan data..."
        
        -- SIMPAN DATA PLAYER (Agar tidak perlu input key lagi)
        if writefile then
            writefile(SAVE_FILE, "Verified by " .. player.Name .. " on " .. os.date())
        end
        
        task.wait(1)
        ScreenGui:Destroy()
        LoadMainScript()
        
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusLabel.Text = "❌ Key Salah! Silakan cari di Discord."
        InputBox.Text = ""
    end
end

ConfirmBtn.MouseButton1Click:Connect(CheckKey)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then CheckKey() end
end)
