local Players = game:GetService("Players")
local player = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()

-- Konfigurasi
local VALID_KEY = "MrFly17"
local DISCORD_LINK = "https://discord.gg/EWQanda7s"
local SAVE_FILE = "MrFly17_Verified.txt" -- Nama file untuk menyimpan data player

-- Fungsi untuk memuat script utama bang
local function LoadMainScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/studiogaming860-web/ImportRbxm/refs/heads/main/Toolbox"))()
    end)
    if not success then 
        warn("Gagal memuat loadstring: " .. tostring(err)) 
    end
end

-- ================= CEK DATA PLAYER =================
-- Jika executor mendukung file system dan file verifikasi sudah ada
if isfile and isfile(SAVE_FILE) then
    -- Player sudah pernah input key, langsung load script tanpa UI
    LoadMainScript()
    return -- Hentikan script di sini
end
